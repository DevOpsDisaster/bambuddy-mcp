# Use the LAN address and published port of your existing Bambuddy container.
# localhost inside bambuddy-mcp refers to bambuddy-mcp itself.
BAMBUDDY_URL=http://192.168.1.10:8000
BAMBUDDY_API_KEY=
# Generate a separate secret with: openssl rand -hex 32
BAMBUDDY_MCP_TOKEN=
BAMBUDDY_MCP_HOST_PORT=8091
# Optionally restrict publishing to the NAS LAN IP.
BAMBUDDY_MCP_BIND_IP=0.0.0.0
BAMBUDDY_DIRECT_MODE=false
